# managed by ansible role nginx_php
server {
    # zone address and loopback only, never the temporary NAT NIC
    listen {{ lab_ip }}:80 default_server;
    listen 127.0.0.1:80;
    server_name {{ lab_site_fqdn }};

    root  {{ wordpress_root }};
    index index.php index.html;

    client_max_body_size {{ nginx_php_upload_max | lower }};

    # log the real client, not the LB
{% for ip in lb_ips %}
    set_real_ip_from {{ ip }};
{% endfor %}
    real_ip_header   X-Forwarded-For;

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        include       fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass  unix:{{ nginx_php_fpm_socket }};
    }

    location = /healthz.php {
        include       fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass  unix:{{ nginx_php_fpm_socket }};
        access_log    off;
    }

    location = /fpm-status {
{% for ip in admin_ips + lb_ips %}
        allow {{ ip }};
{% endfor %}
        allow 127.0.0.1;
        deny  all;
        include       fastcgi_params;
        fastcgi_pass  unix:{{ nginx_php_fpm_socket }};
    }

    # an uploaded .php must never execute
    location ~* /wp-content/uploads/.*\.php$ {
        deny all;
    }
}
