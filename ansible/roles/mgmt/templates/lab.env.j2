# managed by ansible role mgmt: the lab topology as the scenario scripts see it
# generated from the inventory, so an address is never typed twice
LAB_DOMAIN="{{ lab_domain }}"
LAB_SITE="{{ lab_site_fqdn }}"
LAB_VIP="{{ vip_address }}"
LAB_SSH_USER="{{ lab_operator_user }}"
LAB_SSH_KEY="{{ mgmt_ssh_key }}"
LAB_PRIVATE="{{ mgmt_private_dir }}"
LAB_CA_CERT="{{ mgmt_ca_cert }}"

LAB_ALL="{{ groups['lab'] | join(' ') }}"
LAB_ROUTER="{{ groups['router'][0] }}"
LAB_LBS="{{ groups['lb'] | join(' ') }}"
LAB_WEBS="{{ groups['web'] | join(' ') }}"
LAB_DBS="{{ groups['db'] | join(' ') }}"
LAB_NFS="{{ groups['nfs'][0] }}"
LAB_MGMT="{{ groups['mgmt'][0] }}"
LAB_DB_PRIMARY="{{ mysql_primary_host }}"
LAB_WP_INSTALL_HOST="{{ groups['web'][0] }}"

{% for host in groups['lab'] %}
LAB_IP_{{ host }}="{{ hostvars[host].lab_ip }}"
LAB_ZONE_{{ host }}="{{ hostvars[host].lab_zone }}"
{% endfor %}

{% for name, zone in lab_zones.items() %}
LAB_GW_{{ name }}="{{ zone.gateway }}"
LAB_SUBNET_{{ name }}="{{ zone.subnet }}"
{% endfor %}

# HAProxy sticky cookie value per web node, as written in haproxy.cfg
{% for host in groups['web'] %}
LAB_COOKIE_{{ host }}="w{{ loop.index }}"
{% endfor %}

LAB_MYSQL_PORT="{{ mysql_port }}"
LAB_MYSQLCHK_PORT="{{ mysqlchk_port }}"
LAB_STATS_PORT="{{ haproxy_stats_port }}"
LAB_PHP_FPM="php{{ php_version }}-fpm"
LAB_WP_DB="{{ mysql_wp_database }}"
LAB_WP_ROOT="{{ wordpress_root }}"
LAB_UPLOADS="{{ wordpress_uploads_dir }}"
LAB_PROBE_FILE="{{ lab_probe_file }}"
LAB_NFS_EXPORT="{{ nfs_export_path }}"
LAB_MYSQL_WP_CNF="{{ mgmt_private_dir }}/wp.cnf"
LAB_MYSQL_OPS_CNF="{{ mgmt_private_dir }}/ops.cnf"
LAB_SECRETS="{{ mgmt_private_dir }}/secrets.env"
